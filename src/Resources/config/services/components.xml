<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <service id="Kiener\MolliePayments\Components\Installer\PaymentInstaller" public="true">
            <argument type="service" id="payment_method.repository"/>
            <argument type="service" id="Shopware\Core\Framework\Plugin\Util\PluginIdProvider"/>
        </service>

        <service id="Kiener\MolliePayments\Components\Configuration\PluginConfiguration" public="true">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="Kiener\MolliePayments\Components\Mollie\Mollie">
            <argument type="service" id="Kiener\MolliePayments\Components\Configuration\PluginConfiguration"/>
        </service>

    </services>
</container>
